# ローカル実行では空欄のままにします（組み込み PostgreSQL を使用）。
# 外部 PostgreSQL の例: postgresql+psycopg://user:pass@localhost:5432/yla
DATABASE_URL=
# 録画ファイルを置くルートディレクトリです（backend 基準の相対パス）。
STORAGE_ROOT=./data/archive
# ライブ録画の yt-dlp format selector です。空欄は形式を固定しません。
LIVE_QUALITY=
# アーカイブの format selector です。
ARCHIVE_QUALITY=bv*[vcodec^=av01]+ba/bv*[vcodec^=vp9]+ba/bv*+ba/b
# アイコン・チャット画像などのアプリデータ保存先です。
DATA_DIR=./data
# 配信予定サムネイルを許可された YouTube 画像ホストから取得します。
REMOTE_IMAGE_FETCH_ENABLED=true
# yt-dlp 実行ファイル名またはパスです。
YT_DLP_PATH=yt-dlp
YT_DLP_AUTO_UPDATE=true
YT_DLP_UPDATE_CHANNEL=nightly
# YouTube 接続の IP モード: prefer_ipv6 / ipv6 / ipv4 / auto
YOUTUBE_IP_MODE=prefer_ipv6
# ffmpeg 実行ファイル名またはパスです。
FFMPEG_PATH=ffmpeg
# ffprobe 実行ファイル名またはパスです。yt-dlp は PATH から ffmpeg / ffprobe を探すため、どちらも PATH に置いてください。
FFPROBE_PATH=ffprobe
# 再生用に作った MP4（リマックス / H.264 変換）を、最後のアクセスから何日で削除するか指定します。0 は削除しません。
PLAYABLE_CACHE_DAYS=14
# HTTP サーバーの bind address です。
APP_HOST=0.0.0.0
# HTTP サーバーの port です。
APP_PORT=8000
# app logger の出力レベルです（DEBUG / INFO / WARNING / ERROR）。
LOG_LEVEL=INFO
# 起動時に DB 接続を再試行する秒数です。
DATABASE_CONNECT_RETRY_SECONDS=30
# 起動時に Alembic migration を適用します。false の場合、古い schema なら起動を止めます。
AUTO_MIGRATE=true
# 有効時は app_reload_dirs のソース変更で自動再起動します。
APP_RELOAD=false
# APP_RELOAD が監視するディレクトリです。
APP_RELOAD_DIRS=app
# scheduler worker を起動するか指定します。
SCHEDULER_ENABLED=true
# DB transaction を idle のまま維持できる上限時間（ms）です。
DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# アーカイブ取得に使う downloader です（native / aria2c）。
DOWNLOADER=native
# yt-dlp の --concurrent-fragments 値です。
CONCURRENT_FRAGMENTS=16
# aria2c 実行ファイル名またはパスです。
ARIA2C_PATH=aria2c
# aria2c の接続数（-x）です。
ARIA2C_CONNECTIONS=16
# aria2c の split 数（-s）です。
ARIA2C_SPLIT=16
# aria2c の最小分割サイズ（-k）です。
ARIA2C_MIN_SPLIT_SIZE=1M
# aria2c の最大同時ダウンロード数（-j）です。
ARIA2C_MAX_CONCURRENT_DOWNLOADS=4
# チャンネル統計 snapshot の取得間隔（時間）です。
CHANNEL_STATS_INTERVAL_HOURS=24
# YouTube remote request の timeout（秒）です。
REMOTE_TIMEOUT_SECONDS=45
# 1回の monitor cycle で処理する最大 channel 数です。
MONITOR_BATCH_SIZE=20
# channel scan を並行処理する worker 数です。
MONITOR_CONCURRENCY=3
# 1 scan あたりの動画詳細 inspect 上限です。
MONITOR_MAX_INSPECTS_PER_SCAN=5
# 同時 live recording 上限です。
MAX_CONCURRENT_LIVE_RECORDINGS=8
# 同時 archive download 上限です。
MAX_CONCURRENT_ARCHIVE_DOWNLOADS=2
# 録画 recovery の最大試行数です。
RECOVERY_MAX_ATTEMPTS=20
# アプリ shutdown 時に recorder を待つ上限時間（秒）です。
RECORDER_SHUTDOWN_TIMEOUT_SECONDS=20
# 冒頭欠け・複数区間の live recording を archive で補完するか指定します。
LIVE_GAP_BACKFILL=true
# archive 補完を試す録画開始 offset のしきい値（秒）です。
LIVE_GAP_BACKFILL_THRESHOLD_SECONDS=120
# ライブ配信の先頭から録画を試すか指定します。
LIVE_FROM_START=true
# 先頭録画を許可する配信開始からの上限（時間）です。
LIVE_FROM_START_MAX_AGE_HOURS=12
# 利用可能な storage を再試行する間隔（秒）です。
STORAGE_RETRY_SECONDS=60
# 整合性確認 worker の1 batch あたりの最大動画数です。
INTEGRITY_BATCH_SIZE=200
# remote と録画の duration 差を許容する値（秒）です。
DURATION_TOLERANCE_SECONDS=30
# 録画 fingerprint を生成するか指定します。
FINGERPRINT_ENABLED=true
# 映像 fingerprint の最大距離しきい値です。
FINGERPRINT_VIDEO_THRESHOLD=0.25
# 音声 fingerprint の最大距離しきい値です。
FINGERPRINT_AUDIO_THRESHOLD=0.35
# faster-whisper の文字起こしを有効にするか指定します。
TRANSCRIPTION_ENABLED=true
# faster-whisper のモデル名です。
WHISPER_MODEL=large-v3-turbo
# faster-whisper device です（auto / cpu / cuda）。
WHISPER_DEVICE=auto
# faster-whisper compute type です。
WHISPER_COMPUTE_TYPE=auto
# 文字起こし言語です。空欄は自動判定です。
WHISPER_LANGUAGE=
# 同時に実行する transcription job 数です。
TRANSCRIPTION_MAX_CONCURRENCY=1
# transcription job の最大試行数です。
PROCESSING_MAX_ATTEMPTS=5
# OpenRouter API key です。利用時に設定してください。
OPENROUTER_API_KEY=
# OpenRouter の model ID です。要約利用時に設定してください。
OPENROUTER_MODEL=
# OpenRouter API endpoint です。
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter 要約を有効にするか指定します。
SUMMARY_ENABLED=false
# 要約を分割する区間長（分）です。
SUMMARY_CHUNK_MINUTES=30
# 同時に実行する OpenRouter job 数です。
OPENROUTER_MAX_CONCURRENCY=1
# OpenRouter job の最大試行数です。
OPENROUTER_MAX_ATTEMPTS=5

# Docker Compose 専用設定
# Compose の DATABASE_URL は docker-compose.yml が db サービス名で設定します。
POSTGRES_PASSWORD=archiver
ARCHIVE_PATH=./archive
