{
  "name": "youtube-live-archiver-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "postinstall": "node scripts/patch-dplayer-lang.mjs",
    "build": "vue-tsc -b && vite build",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "shots": "node scripts/shots.mjs",
    "format": "prettier --write \"src/**/*.{vue,ts,css}\" \"e2e/**/*.{ts,mjs}\" \"scripts/**/*.mjs\" \"*.config.{js,mjs,ts}\" \"global-setup.ts\" \"playwright.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{vue,ts,css}\" \"e2e/**/*.{ts,mjs}\" \"scripts/**/*.mjs\" \"*.config.{js,mjs,ts}\" \"global-setup.ts\" \"playwright.config.ts\"",
    "lint": "eslint src e2e scripts *.config.mjs *.config.ts global-setup.ts playwright.config.ts"
  },
  "dependencies": {
    "dplayer": "^1.27.1",
    "hls.js": "^1.7.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.0.7",
    "vitest": "^5.0.3",
    "vue-tsc": "^2.2.0"
  },
  "overrides": {
    "axios": "^1.20.0"
  }
}
